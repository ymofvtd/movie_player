<UserControl x:Class="Person_Movie_Player.Views.EpisodeSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Person_Movie_Player.Views"
             Loaded="OnLoaded" Unloaded="OnUnloaded" Width="252">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Sidebar.ShowTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sidebar.ShowTitle}" />
                <ComboBox ItemsSource="{Binding Sidebar.Seasons}" SelectedItem="{Binding Sidebar.SelectedSeason, Mode=TwoWay}"
                          DisplayMemberPath="Label" Margin="0,10,0,0" Style="{StaticResource LibraryComboStyle}"
                          AutomationProperties.Name="Episode season" />
            </StackPanel>
            <Grid Grid.Row="1">
                <ListBox x:Name="EpisodeList" ItemsSource="{Binding Sidebar.Episodes}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Show episodes">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,7" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType={x:Type views:EpisodeSidebar}}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding StateLabel}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template"><Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RowBorder" CornerRadius="6" Padding="10" BorderThickness="1"
                                                        BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource ElevatedSurfaceBrush}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CanPlay}" Value="False"><Setter TargetName="RowBorder" Property="Opacity" Value="0.5" /></DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value></Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Current" FontSize="10" Foreground="{DynamicResource AccentHoverBrush}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibility}}" />
                                        <TextBlock Text="{Binding NumberLabel}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding StateLabel}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" />
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="3" Margin="0,7,0,0"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" />
                                    <TextBlock Text="{Binding ProgressLabel}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No episodes in this season" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Visibility="{Binding Sidebar.HasNoEpisodes, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
            <TextBlock Grid.Row="2" Text="P: previous  ·  N: next" FontSize="10" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>
    </Border>
</UserControl>
