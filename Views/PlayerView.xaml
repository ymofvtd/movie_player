<UserControl x:Class="Person_Movie_Player.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Person_Movie_Player.Views"
             Loaded="OnLoaded" Unloaded="OnUnloaded" IsVisibleChanged="OnVisibilityChanged"
             PreviewMouseMove="OnPlayerMouseMove" PreviewMouseDown="OnPlayerInteraction" PreviewKeyDown="OnPlayerInteraction">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="PlayerHeader" Background="{DynamicResource SurfaceBrush}" Padding="16,12"
                Visibility="{Binding AreControlsVisible, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding Sidebar.ToggleLabel}" Command="{Binding Sidebar.ToggleCommand}"
                        Visibility="{Binding Sidebar.HasShow, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" ToolTip="Show or hide the episode panel" />
                <Button DockPanel.Dock="Right" Content="Open video" Command="{Binding OpenFileCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="16,0,0,0" ToolTip="Open a video (Ctrl+O)" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                            Visibility="{Binding Sidebar.HasShow, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                    <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Command="{Binding PreviousEpisodeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="8,9" ToolTip="Previous available episode (P)"
                            AutomationProperties.Name="Previous episode" />
                    <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Command="{Binding NextEpisodeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="8,9" Margin="5,0,0,0"
                            ToolTip="Next available episode, including the following season (N)" AutomationProperties.Name="Next episode" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding MediaTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <views:EpisodeSidebar Grid.Column="1" Visibility="{Binding Sidebar.IsVisible, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}" />
            <Grid x:Name="VideoHost" ClipToBounds="True">
            <StackPanel x:Name="IdleMessage" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="42" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Open a local video to begin" FontSize="20" Margin="0,20,0,8" TextAlignment="Center" />
                <TextBlock Text="MKV, MP4, and more  ·  Ctrl+O" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" />
            </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource AccentSurfaceBrush}" Padding="16,10"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissErrorCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" Margin="12,0,0,0" />
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <Expander Header="Details" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                              Visibility="{Binding HasErrorDetails, Converter={StaticResource BooleanToVisibility}}">
                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ErrorDetails}" TextWrapping="Wrap" FontSize="11" />
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource AccentSurfaceBrush}" Padding="16,8"
                Visibility="{Binding HasHistoryWarning, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="{Binding HistoryWarning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <Border x:Name="PlaybackControls" Grid.Row="4" Background="{DynamicResource SurfaceBrush}" Padding="16,10,16,14"
                Visibility="{Binding AreControlsVisible, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <StackPanel Visibility="{Binding Sidebar.HasShow, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding EpisodeNavigationMessage}" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="11"
                               Visibility="{Binding HasEpisodeNavigationMessage, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="{Binding Sidebar.Warning}" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="11"
                               Visibility="{Binding Sidebar.HasWarning, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
                <Expander x:Name="PlaybackOptionsPanel" Header="Audio, subtitles &amp; picture" FontSize="11" Margin="0,0,0,8"
                          Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.Name="Playback options">
                <StackPanel Margin="0,10,0,0">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Audio language" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}"
                                  Style="{StaticResource LibraryComboStyle}" IsEnabled="{Binding HasAudioTracks}"
                                  AutomationProperties.Name="Audio language" ToolTip="{Binding AudioTrackHint}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Subtitles" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5" />
                        <ComboBox x:Name="SubtitleSelector" ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay}"
                                  Style="{StaticResource LibraryComboStyle}" IsEnabled="{Binding CanSelectTracks}"
                                  AutomationProperties.Name="Subtitle track" ToolTip="Choose a subtitle track, or Off to hide subtitles">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Load subtitles…" Command="{Binding LoadSubtitleCommand}" VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,9" ToolTip="Load a local SRT, ASS, SSA, VTT, SUB, or IDX file" />
                </Grid>
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                    <TextBlock Text="Speed" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding SelectedSpeed, Mode=TwoWay}"
                              Style="{StaticResource LibraryComboStyle}" Width="86" IsEnabled="{Binding CanAdjustPicture}"
                              AutomationProperties.Name="Playback speed" ToolTip="Playback speed for this session">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0:0.##}×}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Aspect ratio" VerticalAlignment="Center" FontSize="11" Margin="18,0,8,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox ItemsSource="{Binding AspectRatioChoices}" SelectedItem="{Binding SelectedAspectRatio, Mode=TwoWay}"
                              DisplayMemberPath="Label" Style="{StaticResource LibraryComboStyle}" Width="100"
                              IsEnabled="{Binding CanAdjustPicture}" AutomationProperties.Name="Video aspect ratio"
                              ToolTip="Original preserves the file's picture shape; choose a ratio to correct stretched video" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingTime, StringFormat={}{0} left}" FontFamily="Consolas"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                </DockPanel>
                </StackPanel>
                </Expander>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentTime}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationMs}" Value="{Binding SeekPositionMs, Mode=TwoWay}"
                            IsEnabled="{Binding CanSeek}" Margin="14,0" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="OnSeekStarted" PreviewMouseLeftButtonUp="OnSeekCompleted"
                            LostMouseCapture="OnSeekCompleted" AutomationProperties.Name="Playback position"
                            ToolTip="Seek through the video" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding TotalTime}" FontFamily="Consolas" VerticalAlignment="Center" />
                </Grid>
                <DockPanel LastChildFill="False">
                    <Button Content="−10s" Command="{Binding RewindCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,9" ToolTip="Rewind 10 seconds (Left arrow)" AutomationProperties.Name="Rewind 10 seconds" />
                    <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" MinWidth="62"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="10,9" Margin="7,0" ToolTip="Play or pause (Space)" />
                    <Button Content="+10s" Command="{Binding ForwardCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,9" ToolTip="Forward 10 seconds (Right arrow)" AutomationProperties.Name="Forward 10 seconds" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,9" Margin="7,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="{Binding FullscreenLabel}" Command="{Binding FullscreenCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,9" ToolTip="Toggle fullscreen (F); Escape to exit" />
                    <Slider DockPanel.Dock="Right" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"
                            Width="80" VerticalAlignment="Center" Margin="8,0,14,0" TickFrequency="5"
                            AutomationProperties.Name="Volume" ToolTip="Volume (Up / Down arrows)" />
                    <Button DockPanel.Dock="Right" Content="{Binding MuteLabel}" Command="{Binding MuteCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,9" ToolTip="Mute or unmute (M)" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
