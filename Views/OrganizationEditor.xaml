<UserControl x:Class="Person_Movie_Player.Views.OrganizationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource AccentHoverBrush}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
        <Expander Header="Edit details &amp; organization" IsExpanded="{Binding IsExpanded}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20">
            <StackPanel Margin="0,18,0,0" IsEnabled="{Binding CanEdit}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Title" /><TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataTextBoxStyle}" AutomationProperties.Name="Edit title" />
                        <TextBlock Text="Release year (optional)" /><TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataTextBoxStyle}" AutomationProperties.Name="Release year" />
                        <TextBlock Text="Description" /><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Description" />
                        <TextBlock Text="Classification" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding Classifications}" SelectedItem="{Binding Classification}" Style="{StaticResource LibraryComboStyle}" AutomationProperties.Name="Classification" />
                        <TextBlock Text="{Binding ClassificationHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,14" />
                        <StackPanel Visibility="{Binding IsMovie, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Franchise" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding Parents}" SelectedItem="{Binding SelectedParent}" DisplayMemberPath="Label" Style="{StaticResource LibraryComboStyle}" AutomationProperties.Name="Movie franchise" Margin="0,0,0,14" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsEpisode, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Show" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding Parents}" SelectedItem="{Binding SelectedParent}" DisplayMemberPath="Label" Style="{StaticResource LibraryComboStyle}" AutomationProperties.Name="Episode show" Margin="0,0,0,14" />
                            <UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><TextBlock Text="Season" /><TextBox Text="{Binding SeasonNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataTextBoxStyle}" AutomationProperties.Name="Season number" /></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Episode" /><TextBox Text="{Binding EpisodeNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataTextBoxStyle}" AutomationProperties.Name="Episode number" /></StackPanel><StackPanel><TextBlock Text="Range end (optional)" TextWrapping="Wrap" /><TextBox Text="{Binding EpisodeEndNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataTextBoxStyle}" AutomationProperties.Name="Episode range end" /></StackPanel></UniformGrid>
                        </StackPanel>
                        <WrapPanel><Button Content="Save details" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" /><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" /></WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Visibility="{Binding CanCreateFranchise, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel><TextBlock Text="Create a franchise" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Create a collection and add this movie to it." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,6" /><TextBox Text="{Binding NewFranchiseTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataTextBoxStyle}" AutomationProperties.Name="New franchise title" /><Button Content="Create franchise" Command="{Binding CreateFranchiseCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Visibility="{Binding IsFranchise, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel><TextBlock Text="Manage franchise movies" FontSize="18" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding MovieChoices}" SelectedItem="{Binding SelectedMovie}" DisplayMemberPath="Label" Style="{StaticResource LibraryComboStyle}" Margin="0,14,0,12" AutomationProperties.Name="Franchise movie" /><WrapPanel><Button Content="Add to franchise" Command="{Binding AddMovieCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" /><Button Content="Remove from franchise" Command="{Binding RemoveMovieCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" /><Button Content="Move up" Command="{Binding MoveUpCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" /><Button Content="Move down" Command="{Binding MoveDownCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" /></WrapPanel><Separator Margin="0,14" /><TextBlock Text="Remove this grouping to return all its movies to the library. Video files and progress are kept." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" /><Button Content="Remove franchise grouping" Command="{Binding RemoveFranchiseCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Visibility="{Binding CanMerge, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel><TextBlock Text="Combine duplicate titles" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Move this title's files into the selected title as editions or parts. Watch progress stays with each file; the selected title's metadata is kept." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,12" /><ComboBox ItemsSource="{Binding MergeTargets}" SelectedItem="{Binding SelectedMergeTarget}" DisplayMemberPath="Label" Style="{StaticResource LibraryComboStyle}" AutomationProperties.Name="Merge into title" Margin="0,0,0,12" /><Button Content="Merge into selected title" Command="{Binding MergeCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Visibility="{Binding CanSplit, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel><TextBlock Text="Separate an incorrectly grouped file" FontSize="18" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding SplitFiles}" SelectedItem="{Binding SelectedSplitFile}" DisplayMemberPath="Label" Style="{StaticResource LibraryComboStyle}" AutomationProperties.Name="File to separate" Margin="0,14,0,12" /><TextBlock Text="New title" /><TextBox Text="{Binding SplitTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataTextBoxStyle}" AutomationProperties.Name="Separated title" /><Button Content="Separate file" Command="{Binding SplitCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" /></StackPanel>
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
