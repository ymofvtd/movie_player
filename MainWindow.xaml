<Window x:Class="Person_Movie_Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Person_Movie_Player.Views"
        xmlns:services="clr-namespace:Person_Movie_Player.Services"
        Title="MyCinema" Icon="Assets/MyCinema.ico" Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" services:UiMotion.Enabled="{Binding Settings.EnableAnimations}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Player.IsFullscreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="16,28,16,20">
                <StackPanel DockPanel.Dock="Top" Margin="12,0,0,36">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B2;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,4,10,0" />
                        <TextBlock Text="MyCinema" FontSize="25" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="YOUR PERSONAL CINEMA" FontSize="10" Margin="0,10,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,20,0,0">
                    <TextBlock Text="LOCAL. PERSONAL. YOURS." FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="No account. No cloud." FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <ListBox x:Name="MainNavigation" ItemsSource="{Binding NavigationItems}" BorderThickness="0"
                         Background="Transparent" SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Main navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Margin" Value="36,28,36,24" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Player.IsFullscreen}" Value="True">
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="Margin" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,28">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Player.IsFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Content="&#xE72B;"
                        Style="{StaticResource SecondaryButtonStyle}" FontFamily="Segoe MDL2 Assets"
                        Width="38" Height="38" Padding="0" Margin="0,0,16,0" ToolTip="Go back (Alt+Left)"
                        AutomationProperties.Name="Go back" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentPage.Description}" Margin="0,7,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
            <ContentControl x:Name="LibraryContent" Grid.Row="1" Content="{Binding LibraryPage}" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
            <!-- Keep the native HWND alive while the user browses other pages. -->
            <views:PlayerView x:Name="PlayerContent" Grid.Row="1" DataContext="{Binding Player}">
                <views:PlayerView.Style>
                    <Style TargetType="views:PlayerView">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPlayerPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:PlayerView.Style>
            </views:PlayerView>
            <TextBlock Grid.Row="2" Text="MyCinema  /  On your device" FontSize="11" Margin="0,24,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Player.IsFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
